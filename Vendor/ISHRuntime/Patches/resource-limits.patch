+// Applies to regular guest files, not PTYs, pipes, or host preparation I/O.
+static bool familiar_file_write_fits(struct fd *fd, size_t size, off_t offset) {
+    if (!current || current->familiar_execution_owner == 0) return true;
+    struct stat st;
+    if (fstat(fd->real_fd, &st) < 0) return false;
+    if (!S_ISREG(st.st_mode)) return true;
+    if (fcntl(fd->real_fd, F_GETFL) & O_APPEND) offset = st.st_size;
+    if (offset < 0) offset = lseek(fd->real_fd, 0, SEEK_CUR);
+    const uint64_t maximum = 128ULL * 1024 * 1024;
+    return offset >= 0 && (uint64_t)offset <= maximum && size <= maximum - (uint64_t)offset;
+}
