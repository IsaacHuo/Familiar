+// Darwin host sleeps can keep restarting despite the guest's pending signal.
+// Bound each wait so cancellation reaches the guest kernel without waiting for
+// the complete requested sleep, and report the real remaining interval.
+static int guest_nanosleep(const struct timespec *request, struct timespec *remaining) {
+    if (request->tv_sec < 0 || request->tv_nsec < 0 || request->tv_nsec >= 1000000000) return _EINVAL;
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    if (request->tv_sec > LLONG_MAX - now.tv_sec - 1) return _EINVAL;
+    struct timespec deadline = {now.tv_sec + request->tv_sec, now.tv_nsec + request->tv_nsec};
+    if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+    for (;;) {
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        time_t seconds = deadline.tv_sec - now.tv_sec;
+        long nanos = deadline.tv_nsec - now.tv_nsec;
+        if (nanos < 0) { seconds--; nanos += 1000000000; }
+        if (seconds < 0 || (seconds == 0 && nanos == 0)) { *remaining = (struct timespec){0, 0}; return 0; }
+        *remaining = (struct timespec){seconds, nanos};
+        bool interrupted = current->group->doing_group_exit;
+        if (current->sighand) {
+            lock(&current->sighand->lock);
+            interrupted |= (current->pending & ~current->blocked) != 0 || sigset_has(current->pending, SIGKILL_);
+            unlock(&current->sighand->lock);
+        }
+        if (interrupted) return _EINTR;
+        struct timespec slice = {0, seconds > 0 ? 50000000 : (nanos < 50000000 ? nanos : 50000000)};
+        if (nanosleep(&slice, NULL) < 0 && errno != EINTR) return errno_map();
+    }
+}
