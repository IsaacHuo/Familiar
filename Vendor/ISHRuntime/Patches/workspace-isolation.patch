+// Native guest owners reap only their stopped, init-adopted children. A live
+// session continues to use the ordinary Linux wait semantics.
+void familiar_ish_reap_execution_owner(uint64_t owner) {
+    if (owner == 0) return;
+    lock(&pids_lock);
+    struct task *saved = current;
+    struct task *init = pid_get_task(1);
+    current = init;
+    if (init) {
+        for (int pid = 2; pid <= MAX_PID; pid++) {
+            struct task *task = pid_get_task_zombie(pid);
+            if (task && task->familiar_execution_owner == owner && task->zombie && task->parent == init) {
+                struct siginfo_ info = SIGINFO_NIL;
+                reap_if_zombie(task, &info, NULL, WEXITED_);
+            }
+        }
+    }
+    current = saved;
+    unlock(&pids_lock);
+}
